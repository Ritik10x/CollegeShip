rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.token.email)).data.role == 'admin';
    }

    match /{allPaths=**} {
      allow read;
    }

    match /colleges/{allPaths=**} {
      allow write: if request.auth != null;
    }

    match /showcase-reviews/{reviewId}/{fileName} {
      allow read;
      allow write: if isAdmin();
    }
  }
}
